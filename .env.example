# Which AI model powers the live agent: groq | ollama | none
# "none" runs the scripted scenarios only (no internet needed).
LLM_PROVIDER=groq

# Free key from https://console.groq.com (no credit card needed)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Offline option: install Ollama, then `ollama pull llama3.1:8b`
OLLAMA_MODEL=llama3.1:8b

# Local files and secrets (demo values are fine)
DB_PATH=halcyon.db
HMAC_SECRET=change-me-for-your-demo
